set.seed(1)
programs <- matrix(rnorm(60), 30, 2)
simulate <- function(d, n = 40) {
  X <- tcrossprod(matrix(rnorm(2 * n), n, 2), programs) + matrix(rnorm(30 * n, sd = 0.3), n, 30)
  dimnames(X) <- list(paste0(d, "_s", seq_len(n)), paste0("g", 1:30))
  X
